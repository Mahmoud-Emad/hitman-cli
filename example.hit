# Variable definitions with real API targets
DEFINE token="QpwL5tke4Pnpja7X4"
DEFINE url="https://reqres.in/api"
DEFINE number=123
DEFINE boolean=true;
DEFINE headers={
    "Content-Type": "application/json",
    "Authorization": "Bearer {{token}}"
}
DEFINE data={
    "test": true
}

# Simple GET request with variable (jsonplaceholder)
GET https://jsonplaceholder.typicode.com/posts
    WITH HEADER {{headers}}

# Request with token in query
GET {{url}}/users?token={{token}}

# Request with number in query
GET {{url}}/users?number={{number}}

# Request with boolean in query
GET {{url}}/users?boolean={{boolean}}

# All in one block with variables
POST {{url}}/users
    WITH HEADER {{headers}}
    WITH DATA {{data}}
    WITH QUERY {
        "token": "{{token}}",
        "number": {{number}},
        "boolean": {{boolean}}
    }

# Without variables - fully expanded
POST https://reqres.in/api/users
    WITH HEADER {
        "Content-Type": "application/json",
        "Authorization": "Bearer QpwL5tke4Pnpja7X4"
    }
    WITH DATA {
        "test": true
    }
    WITH QUERY {
        "token": "QpwL5tke4Pnpja7X4",
        "number": 123,
        "boolean": true
    }

# Additional valid POST example
POST https://reqres.in/api/register
    WITH HEADER {
        "Content-Type": "application/json"
    }
    WITH DATA {
        "email": "eve.holt@reqres.in",
        "password": "pistol"
    }

# Valid GET example from httpbin
GET https://httpbin.org/get
    WITH QUERY {
        "example": "value"
    }
